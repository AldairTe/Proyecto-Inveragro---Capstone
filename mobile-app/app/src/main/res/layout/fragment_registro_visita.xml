<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:id="@+id/topBarVisita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackVisita"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/arrow_back_ios_24px"
            app:tint="#424242" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Registro de Visita"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily=""
            android:textStyle="bold" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarVisita"
        app:layout_constraintBottom_toTopOf="@id/bottomBarGuardar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/white"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/calendar_clock_24px"
                        app:tint="#555555" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha de Visita"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textColor="#000000" />

                        <TextView
                            android:id="@+id/tvFechaActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9 jul 2026 • 10:25"
                            android:fontFamily="@font/poppins"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/route_24px" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Notas de la reunión"
                android:fontFamily="@font/poppins"
                android:textColor="#000000"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotasVisita"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:hint="Ingrese los detalles discutidos durante la visita, acuerdos, observaciones del terreno..."
                    android:inputType="textMultiLine"
                    android:fontFamily="@font/poppins"
                    android:padding="12dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Checklist agronómico (dinámico, configurado en Odoo). Oculto si no hay ítems. -->
            <LinearLayout
                android:id="@+id/llChecklistSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Checklist Agronómico"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llChecklistItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Firma digital del cliente (opcional, según configuración de Odoo) -->
            <LinearLayout
                android:id="@+id/llFirmaSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Firma del Cliente (opcional)"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/ivFirmaPreview"
                        android:layout_width="80dp"
                        android:layout_height="50dp"
                        android:background="#F5F6F8"
                        android:scaleType="fitCenter"
                        android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFirmar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="#494949"
                        android:fontFamily="@font/poppins"
                        android:text="Capturar Firma" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sección de Evidencias / Multimedia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Evidencias Fotográficas"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F5F6F8"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D0D0D0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:background="@drawable/bg_circle_blue"
                        android:backgroundTint="#E0E0E0"
                        app:tint="#757575"
                        android:padding="12dp"/>

                    <TextView
                        android:id="@+id/tvEstadoMultimedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="Aún no se han adjuntado imágenes."
                        android:textColor="#555555" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjuntarMultimedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#494949"
                        android:layout_marginTop="16dp"
                        app:icon="@android:drawable/ic_menu_gallery"
                        android:fontFamily="@font/poppins"
                        android:text="Adjuntar Fotos/Videos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Productos Interesados"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F5F6F8"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D0D0D0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_add"
                        android:background="@drawable/bg_circle_blue"
                        android:backgroundTint="#E0E0E0"
                        app:tint="#757575"
                        android:padding="12dp"/>

                    <TextView
                        android:id="@+id/tvEstadoProductos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="Aún no se han agregado productos."
                        android:textColor="#555555" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnadirProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#494949"
                        android:layout_marginTop="16dp"
                        app:icon="@android:drawable/ic_input_add"
                        android:fontFamily="@font/poppins"
                        android:text="Añadir Producto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBarGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizarGuardar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Finalizar y Guardar"
            android:textSize="18sp"
            app:cornerRadius="30dp"
            android:backgroundTint="#8BC34A"
            app:icon="@android:drawable/ic_menu_save"
            app:iconSize="24dp"
            app:iconTint="@color/white"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>