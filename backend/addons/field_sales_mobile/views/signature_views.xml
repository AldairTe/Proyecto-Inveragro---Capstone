<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_signature_config_form" model="ir.ui.view">
        <field name="name">field.sales.signature.config.form</field>
        <field name="model">field.sales.signature.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Firma Digital">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active_feature"/>
                    </group>
                    <p class="text-muted">
                        Si lo activas, la app ofrecerá capturar la firma del cliente al cerrar
                        una visita o un pedido. Siempre es opcional para el vendedor, aunque
                        esté habilitado.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_signature_config_tree" model="ir.ui.view">
        <field name="name">field.sales.signature.config.tree</field>
        <field name="model">field.sales.signature.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active_feature"/>
            </tree>
        </field>
    </record>

    <record id="action_field_sales_signature_config" model="ir.actions.act_window">
        <field name="name">Configuración de Firma Digital</field>
        <field name="res_model">field.sales.signature.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
