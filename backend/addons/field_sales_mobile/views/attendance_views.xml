<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registros de asistencia: vista calendario (principal) + lista -->

    <record id="view_field_sales_attendance_calendar" model="ir.ui.view">
        <field name="name">field.sales.attendance.calendar</field>
        <field name="model">field.sales.attendance</field>
        <field name="arch" type="xml">
            <calendar string="Asistencias" date_start="date_attendance" color="employee_id" mode="month" quick_add="false">
                <field name="employee_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_field_sales_attendance_tree" model="ir.ui.view">
        <field name="name">field.sales.attendance.tree</field>
        <field name="model">field.sales.attendance</field>
        <field name="arch" type="xml">
            <tree string="Asistencias" default_order="date_attendance desc" create="false">
                <field name="employee_id"/>
                <field name="date_attendance"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </tree>
        </field>
    </record>

    <record id="view_field_sales_attendance_search" model="ir.ui.view">
        <field name="name">field.sales.attendance.search</field>
        <field name="model">field.sales.attendance</field>
        <field name="arch" type="xml">
            <search string="Buscar Asistencias">
                <field name="employee_id"/>
                <filter string="Hoy" name="filter_today" domain="[('date_attendance', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_attendance', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vendedor" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_field_sales_attendance" model="ir.actions.act_window">
        <field name="name">Asistencias</field>
        <field name="res_model">field.sales.attendance</field>
        <field name="view_mode">calendar,tree</field>
        <field name="search_view_id" ref="view_field_sales_attendance_search"/>
        <field name="context">{'search_default_filter_today': 0}</field>
    </record>

    <!-- Configuración: cuántas marcaciones por día permite cada empresa (o si no usa asistencia) -->

    <record id="view_field_sales_attendance_config_form" model="ir.ui.view">
        <field name="name">field.sales.attendance.config.form</field>
        <field name="model">field.sales.attendance.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Asistencia">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active_feature"/>
                        <field name="max_per_day" attrs="{'invisible': [('active_feature', '=', False)]}"/>
                    </group>
                    <p class="text-muted">
                        Si desactivas "Habilitar asistencia", el botón "Marcar Asistencia" desaparece de la app
                        para todos los vendedores. "Marcaciones permitidas por día" en 0 significa sin límite.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_attendance_config_tree" model="ir.ui.view">
        <field name="name">field.sales.attendance.config.tree</field>
        <field name="model">field.sales.attendance.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active_feature"/>
                <field name="max_per_day"/>
            </tree>
        </field>
    </record>

    <record id="action_field_sales_attendance_config" model="ir.actions.act_window">
        <field name="name">Configuración de Asistencia</field>
        <field name="res_model">field.sales.attendance.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
