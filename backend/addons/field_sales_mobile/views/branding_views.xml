<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_branding_config_form" model="ir.ui.view">
        <field name="name">field.sales.branding.config.form</field>
        <field name="model">field.sales.branding.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Marca (White-Label)">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="app_display_name"/>
                            <field name="primary_color"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" options="{'size': [200, 200]}"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        El nombre, color y logo se aplican en el login y el dashboard de la app
                        móvil de esta empresa. El ícono/nombre del APK en sí no cambia sin
                        recompilar la app.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_branding_config_tree" model="ir.ui.view">
        <field name="name">field.sales.branding.config.tree</field>
        <field name="model">field.sales.branding.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="app_display_name"/>
                <field name="primary_color"/>
            </tree>
        </field>
    </record>

    <record id="action_field_sales_branding_config" model="ir.actions.act_window">
        <field name="name">Configuración de Marca (White-Label)</field>
        <field name="res_model">field.sales.branding.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
