<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_visit_tree" model="ir.ui.view">
        <field name="name">field.sales.visit.tree</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <tree string="Visitas" default_order="date_visit desc"
                  decoration-success="state == 'completed'"
                  decoration-warning="state == 'pending'">
                <field name="date_visit"/>
                <field name="employee_id"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="media_count"/>
            </tree>
        </field>
    </record>

    <record id="view_field_sales_visit_form" model="ir.ui.view">
        <field name="name">field.sales.visit.form</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <form string="Visita">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="customer_id"/>
                            <field name="date_visit"/>
                            <field name="state"/>
                        </group>
                        <group string="Ubicación">
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Evidencias (fotos / videos)">
                            <field name="media_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="media_type"/>
                                    <field name="captured_at"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="media_type"/>
                                        <field name="file" widget="binary" filename="name"/>
                                        <field name="latitude"/>
                                        <field name="longitude"/>
                                        <field name="captured_at"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Checklist agronómico">
                            <field name="checklist_ids" readonly="1">
                                <tree>
                                    <field name="item_id"/>
                                    <field name="checked"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Firma del cliente">
                            <field name="signature" widget="image" nolabel="1" options="{'size': [300, 150]}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_visit_search" model="ir.ui.view">
        <field name="name">field.sales.visit.search</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <search string="Buscar visitas">
                <field name="customer_id"/>
                <field name="employee_id"/>
                <filter string="Hoy" name="today"
                        domain="[('date_visit', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('date_visit', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Pendientes" name="pending" domain="[('state', '=', 'pending')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vendedor" name="group_seller" context="{'group_by': 'employee_id'}"/>
                    <filter string="Cliente" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_field_sales_visit_pivot" model="ir.ui.view">
        <field name="name">field.sales.visit.pivot</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <pivot string="Reporte de visitas">
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_field_sales_visit_graph" model="ir.ui.view">
        <field name="name">field.sales.visit.graph</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <graph string="Visitas por vendedor" type="bar">
                <field name="employee_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_field_sales_visit" model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">field.sales.visit</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_field_sales_visit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay visitas registradas.
            </p>
            <p>Las visitas se crean principalmente desde la app móvil.</p>
        </field>
    </record>

    <record id="action_field_sales_visit_report" model="ir.actions.act_window">
        <field name="name">Reportes de Visitas</field>
        <field name="res_model">field.sales.visit</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_field_sales_visit_search"/>
    </record>

    <record id="view_field_sales_visit_frequency_pivot" model="ir.ui.view">
        <field name="name">field.sales.visit.frequency.pivot</field>
        <field name="model">field.sales.visit</field>
        <field name="arch" type="xml">
            <pivot string="Frecuencia de visitas por cliente">
                <field name="customer_id" type="row"/>
                <field name="employee_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_field_sales_visit_frequency_report" model="ir.actions.act_window">
        <field name="name">Frecuencia de Visitas por Cliente</field>
        <field name="res_model">field.sales.visit</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" ref="view_field_sales_visit_frequency_pivot"/>
        <field name="search_view_id" ref="view_field_sales_visit_search"/>
    </record>

</odoo>
