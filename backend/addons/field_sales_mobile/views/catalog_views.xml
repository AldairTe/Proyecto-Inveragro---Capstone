<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_catalog_config_form" model="ir.ui.view">
        <field name="name">field.sales.catalog.config.form</field>
        <field name="model">field.sales.catalog.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Catálogo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_category_id"/>
                        <field name="pricelist_id"/>
                        <field name="show_stock"/>
                    </group>
                    <p class="text-muted">
                        Define de dónde saca la app los productos que el vendedor puede ofrecer:
                        elige una categoría para limitar el catálogo (vacío = todos los productos vendibles)
                        y una lista de precios (vacío = la lista de precios por defecto).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_catalog_config_tree" model="ir.ui.view">
        <field name="name">field.sales.catalog.config.tree</field>
        <field name="model">field.sales.catalog.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="pricelist_id"/>
            </tree>
        </field>
    </record>

    <record id="action_field_sales_catalog_config" model="ir.actions.act_window">
        <field name="name">Configuración de Catálogo</field>
        <field name="res_model">field.sales.catalog.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
