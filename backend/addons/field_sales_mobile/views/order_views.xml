<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_order_tree" model="ir.ui.view">
        <field name="name">field.sales.order.tree</field>
        <field name="model">field.sales.order</field>
        <field name="arch" type="xml">
            <tree string="Pedidos" default_order="date_order desc">
                <field name="date_order"/>
                <field name="employee_id"/>
                <field name="customer_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_field_sales_order_form" model="ir.ui.view">
        <field name="name">field.sales.order.form</field>
        <field name="model">field.sales.order</field>
        <field name="arch" type="xml">
            <form string="Pedido">
                <header>
                    <button name="action_convert_to_quotation" type="object" string="Convertir a Cotización"
                            class="btn-primary" attrs="{'invisible': [('sale_order_id', '!=', False)]}"/>
                    <button name="action_convert_to_sale" type="object" string="Convertir a Venta"
                            class="btn-secondary" attrs="{'invisible': [('sale_order_id', '!=', False)]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="sale_order_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_sale_order" icon="fa-file-text-o"
                                attrs="{'invisible': [('sale_order_id', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Cotización/Venta</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="customer_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observaciones..."/>
                    <notebook>
                        <page string="Productos">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Firma del cliente">
                            <field name="signature" widget="image" nolabel="1" options="{'size': [300, 150]}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_order_search" model="ir.ui.view">
        <field name="name">field.sales.order.search</field>
        <field name="model">field.sales.order</field>
        <field name="arch" type="xml">
            <search string="Buscar Pedidos">
                <field name="customer_id"/>
                <field name="employee_id"/>
                <filter string="Convertidos" name="converted" domain="[('state', '=', 'converted')]"/>
                <filter string="Sin convertir" name="not_converted" domain="[('state', '=', 'new')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vendedor" name="group_seller" context="{'group_by': 'employee_id'}"/>
                    <filter string="Cliente" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_field_sales_order_pivot" model="ir.ui.view">
        <field name="name">field.sales.order.pivot</field>
        <field name="model">field.sales.order</field>
        <field name="arch" type="xml">
            <pivot string="Reporte de Pedidos">
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_field_sales_order_graph" model="ir.ui.view">
        <field name="name">field.sales.order.graph</field>
        <field name="model">field.sales.order</field>
        <field name="arch" type="xml">
            <graph string="Pedidos por vendedor" type="bar">
                <field name="employee_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_field_sales_order" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">field.sales.order</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_field_sales_order_search"/>
    </record>

    <record id="action_field_sales_order_report" model="ir.actions.act_window">
        <field name="name">Reportes de Pedidos</field>
        <field name="res_model">field.sales.order</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_field_sales_order_search"/>
    </record>

</odoo>
