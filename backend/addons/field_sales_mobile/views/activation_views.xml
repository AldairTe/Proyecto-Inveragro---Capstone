<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_sales_activation_form" model="ir.ui.view">
        <field name="name">field.sales.activation.form</field>
        <field name="model">field.sales.activation</field>
        <field name="arch" type="xml">
            <form string="Activación App Móvil">
                <header>
                    <button name="action_regenerate_code" type="object" string="Regenerar Código"
                            class="btn-secondary"
                            confirm="Esto revocará todos los dispositivos activados con el código actual. ¿Continuar?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_devices" icon="fa-mobile">
                            <field name="device_count" widget="statinfo" string="Dispositivos"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="activation_code"/>
                            <field name="server_url"/>
                            <field name="max_devices"/>
                        </group>
                        <group>
                            <field name="qr_image" widget="image" nolabel="1" options="{'size': [200, 200]}"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Comparte este código (o el QR) solo con quien deba activar la app en un celular nuevo.
                        En el primer inicio, la app pedirá este código junto con la URL del servidor.
                    </p>
                    <notebook>
                        <page string="Dispositivos activados">
                            <field name="device_ids">
                                <tree>
                                    <field name="device_name"/>
                                    <field name="device_id"/>
                                    <field name="active"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_sales_activation_tree" model="ir.ui.view">
        <field name="name">field.sales.activation.tree</field>
        <field name="model">field.sales.activation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="activation_code"/>
                <field name="device_count"/>
                <field name="max_devices"/>
            </tree>
        </field>
    </record>

    <record id="action_field_sales_activation" model="ir.actions.act_window">
        <field name="name">Activación App Móvil</field>
        <field name="res_model">field.sales.activation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_field_sales_activation_devices" model="ir.actions.act_window">
        <field name="name">Dispositivos Activados</field>
        <field name="res_model">field.sales.activation.device</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
