<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_sales" model="ir.module.category">
        <field name="name">Fuerza de Ventas</field>
        <field name="sequence">20</field>
    </record>

    <!-- Supervisor: ve vendedores, clientes, visitas y reportes en el backend -->
    <record id="group_field_sales_user" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_field_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrador del módulo (configuración, ya incluido para el admin de Odoo) -->
    <record id="group_field_sales_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_field_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_field_sales_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
